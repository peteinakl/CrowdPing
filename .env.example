# Copy to .env (git-ignored) and fill in real values. No secrets belong in this file.
# See docs/ENVIRONMENT.md for the full explanation of every variable and which
# environment (local / staging / production) sets it.

# ---- Canonical application origin (PRD "Canonical base URL and environments") ----
# Authoritative deployment setting. Must be an absolute HTTPS origin with no path/query/
# fragment/userinfo. http is only allowed for explicitly configured localhost dev.
APP_BASE_URL=http://127.0.0.1:8788
# Frontend build-time mirror of APP_BASE_URL. Must be identical for a given environment.
VITE_APP_BASE_URL=http://127.0.0.1:8788

# ---- Supabase (organiser identity + database) ----
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=replace-with-local-anon-key-from-supabase-start
SUPABASE_FUNCTIONS_BASE_URL=http://127.0.0.1:54321/functions/v1

# Exact allowed frontend origins for Edge Function origin checks (comma-separated, no trailing slash).
ALLOWED_APP_ORIGINS=http://127.0.0.1:8788

# ---- Voter credential signing (Supabase Edge Function secrets only; never in the frontend bundle) ----
# Comma-separated, current key first. Generate with: openssl rand -base64 32
VOTER_COOKIE_SIGNING_KEYS=replace-with-a-generated-32-byte-key
VOTER_KEY_DERIVATION_KEY=replace-with-a-different-generated-32-byte-key

# Set to "false" only for non-HTTPS localhost development. The startup validator refuses
# COOKIE_SECURE=false paired with a non-localhost APP_BASE_URL.
COOKIE_SECURE=false

# ---- Supabase project credentials used only by test fixtures (e2e/, never shipped app code) ----
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key-from-supabase-start
